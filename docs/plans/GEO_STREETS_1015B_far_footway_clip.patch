+/* [ROUND 1015 B item 5] Does a real street's CARRIAGEWAY lie over this footway slab?
+ *
+ * tg_av_far_mouth breaks the footway on the spans a street's mouth table lists, and a
+ * street that leaves the far kerb at 45 degrees (all of La Plata's diagonal grid) sweeps
+ * ALONG the road as it moves out: at the footway's lateral, up to one span past where the
+ * mouth says it begins. So the span next to the mouth still carried a slab over the street's
+ * oblique edge -- audited as pavement standing on the street surface -- and the two ended at
+ * different angles, which is "this sidewalk is not properly aligned to the crossing road".
+ * Here the slab is sampled (3 stations along x 3 across) and a span whose slab has any sample
+ * inside a mouth quad (the kerb segment of a mouth span swept along ITS outward bearing for
+ * the mouth's reach, exactly what tg_city_emit_crossstreet lays) is treated as a mouth too, so
+ * the footway stops short of the street and the neighbours cap it.
+ * TD5RE_GEO_FAR_STREET_CLIP=0 restores the span-granular break. */
+static int tg_av_pt_in_quad(const double *q, double x, double z)
+{
+    int i, pos = 0, neg = 0;
+    for (i = 0; i < 4; i++) {
+        const double ax = q[i * 2], az = q[i * 2 + 1];
+        const double bx = q[((i + 1) & 3) * 2], bz = q[((i + 1) & 3) * 2 + 1];
+        const double c = (bx - ax) * (z - az) - (bz - az) * (x - ax);
+        if (c > 0.0) pos = 1; else if (c < 0.0) neg = 1;
+    }
+    return !(pos && neg);
+}
+
+static int tg_av_slab_hits_street(const TG_NodeList *nl, int s, double e0, double e1,
+                                  double sw, double sg)
+{
+    const TG_Node *a, *c;
+    const int left = (sg > 0.0);
+    int m, iu, il;
+    if (!td5_env_flag_on("TD5RE_GEO_FAR_STREET_CLIP")) return 0;
+    if (!nl || s < 0 || s + 1 >= nl->count || !(sw > 0.0)) return 0;
+    a = &nl->v[s]; c = &nl->v[s + 1];
+    for (m = s - 3; m <= s + 3; m++) {
+        double sk = 0.0, rr = 0.0, ef[10], q[8], no[2], fo[2], cs, sn;
+        if (m < 1 || m + 1 >= nl->count) continue;
+        if (!(tg_net_mouth_shift(m, left) > 0.0) || tg_net_mouth_kind(m, left) < 0) continue;
+        if (tg_net_mouth(m, left, &sk, &rr) < 0 || !(rr > 0.0)) continue;
+        tg_city_edge_frame(nl, m, sg, ef);
+        cs = cos(sk); sn = sin(sk);
+        no[0] = ef[6] * cs - ef[7] * sn; no[1] = ef[6] * sn + ef[7] * cs;
+        fo[0] = ef[8] * cs - ef[9] * sn; fo[1] = ef[8] * sn + ef[9] * cs;
+        q[0] = ef[0];                q[1] = ef[2];
+        q[2] = ef[0] + no[0] * rr;   q[3] = ef[2] + no[1] * rr;
+        q[4] = ef[3] + fo[0] * rr;   q[5] = ef[5] + fo[1] * rr;
+        q[6] = ef[3];                q[7] = ef[5];
+        for (iu = 0; iu < 3; iu++) {
+            const double u = 0.1 + 0.4 * (double)iu;
+            const double ex = e0 + (e1 - e0) * u;
+            const double bx0 = a->x + (c->x - a->x) * u, bz0 = a->z + (c->z - a->z) * u;
+            const double tz = a->tz + (c->tz - a->tz) * u, tx = a->tx + (c->tx - a->tx) * u;
+            for (il = 0; il < 3; il++) {
+                const double lat = ex + sg * sw * (0.1 + 0.4 * (double)il);
+                const double x = bx0 + tz * lat, z = bz0 - tx * lat;
+                if (tg_av_pt_in_quad(q, x, z)) return 1;
+            }
+        }
+    }
+    return 0;
+}
